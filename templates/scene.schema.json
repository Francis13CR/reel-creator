{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reel Creator scene file",
  "type": "object",
  "required": ["version", "video", "scenes"],
  "properties": {
    "version": { "const": 1 },
    "video": {
      "type": "object",
      "required": ["id", "width", "height", "fps", "duration_s", "voice"],
      "properties": {
        "id": { "type": "string" },
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "const": 30 },
        "duration_s": { "type": "number", "minimum": 15, "maximum": 90 },
        "tail_s": { "type": "number", "minimum": 0, "default": 1 },
        "voice": { "type": "string" },
        "music": { "type": ["string", "null"] }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "beat_id", "order", "type"],
        "properties": {
          "id": { "type": "string", "pattern": "^s[0-9]+$" },
          "beat_id": { "type": "string", "pattern": "^b[0-9]+$" },
          "order": { "type": "integer", "minimum": 1 },
          "type": {
            "enum": [
              "hook",
              "split",
              "map",
              "timeline",
              "data",
              "quote",
              "compare",
              "object",
              "matrix",
              "outro"
            ]
          },
          "visual": { "type": "string" },
          "text": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "subtitle": { "type": "string" },
              "body": { "type": "string" }
            }
          },
          "anchor_start": { "$ref": "#/$defs/anchor" },
          "anchor_end": { "$ref": "#/$defs/anchor" },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["src"],
              "properties": {
                "type": { "type": "string" },
                "src": { "type": "string" },
                "focus": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": ["word"],
      "properties": {
        "word": { "type": "string" },
        "occurrence": { "type": "integer", "minimum": 1, "default": 1 },
        "edge": { "enum": ["start", "end"], "default": "start" },
        "offset_s": { "type": "number", "default": 0 }
      }
    }
  }
}
